# ───────── MaliREN API  copy to .env and adjust. NEVER commit .env ─────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (docker compose provides this host/user/password for local use only)
DATABASE_URL=postgresql://maliren:maliren@localhost:5432/maliren

# Browser origins allowed to call the API (comma separated). Used for CORS and for the refresh-cookie CSRF check.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PUBLIC_SITE_URL=http://localhost:5173
# Set to the number of reverse proxies in front of the API (nginx = 1) so rate limiting sees real client IPs.
TRUST_PROXY=0

# Auth  generate with: openssl rand -hex 48   (≥ 32 chars; the default is refused in production)
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Defaults: secure cookies only in production. For a frontend on another *site* use COOKIE_SAMESITE=none + COOKIE_SECURE=true.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SCRYPT_N=32768
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MIN=60

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# E-mail. MAIL_MODE=log prints e-mails to the log and records them in Admin → Activité → E-mails (nothing is sent).
MAIL_MODE=log
MAIL_FROM="MaliREN <no-reply@maliren.ml>"
# MAIL_MODE=smtp  (docker compose ships a Mailpit capture server on smtp://mailpit:1025, UI on http://localhost:8025)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Extra notification recipients (comma separated); active admins/editors are notified in-app and by e-mail anyway.
ADMIN_NOTIFY_EMAIL=

# Automation. EMBEDDED_WORKER=true runs the worker inside the API process (simplest). Docker Compose runs a separate worker.
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=5
AUTOMATIONS_ENABLED=true

# Seeding. Demo users (admin@/manager@/editor@/reviewer@maliren.ml) are created outside production only,
# or in production when ALLOW_DEMO_SEED=true (not recommended).
ALLOW_DEMO_SEED=false
DEMO_PASSWORD="Maliren#Demo2026"
# First real super-admin (must change password at first login). Required to bootstrap production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
