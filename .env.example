# ───────── Docker Compose settings. `node scripts/init-env.mjs` copies this file to .env and fills the secrets. ─────────
# NEVER commit .env.

# Required (generated by scripts/init-env.mjs)
POSTGRES_PASSWORD=
JWT_SECRET=

# Where the site is served (used for CORS, the refresh-cookie CSRF check and links in e-mails).
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080
PUBLIC_SITE_URL=http://localhost:8080

# Cookies. Set COOKIE_SECURE=true once the site is behind HTTPS (required for production).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# E-mail: the default sends to the bundled Mailpit inbox (http://localhost:8025)  nothing leaves your machine.
# For real delivery set your provider's SMTP settings, e.g. MAIL_MODE=smtp SMTP_HOST=smtp.example.org SMTP_PORT=587 SMTP_USER=... SMTP_PASS=...
MAIL_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="MaliREN <no-reply@maliren.ml>"
ADMIN_NOTIFY_EMAIL=

# Automations (see README → "Automations"). false disables every scheduled job.
AUTOMATIONS_ENABLED=true

# Demo data. ALLOW_DEMO_SEED=true creates the 4 demo accounts (admin@/manager@/editor@/reviewer@maliren.ml) with DEMO_PASSWORD.
# DEMO ONLY  leave false in production and bootstrap a real administrator with SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD instead.
ALLOW_DEMO_SEED=true
DEMO_PASSWORD="Maliren#Demo2026"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
